
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Task Manager</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app">
    <header>
      <p>YOUR PERSONAL STUDY SPACE</p>
      <h1>Study Planner 📚</h1>
      <p>Plan your day. Achieve your goals.</p>
    </header>

    <section class="stats">
      <div class="stat">Total Tasks <strong id="total">0</strong></div>
      <div class="stat">Pending <strong id="pending">0</strong></div>
      <div class="stat">Completed <strong id="completed">0</strong></div>
    </section>

    <section class="panel">
      <h2>Add a new task</h2>
      <form id="taskForm">
        <label for="taskInput">Task name</label>
        <input id="taskInput" required maxlength="120"
          placeholder="e.g. Study Maths">

        <label for="subjectInput">Subject</label>
        <input id="subjectInput" maxlength="60"
          placeholder="e.g. Mathematics">

        <label for="dateInput">Deadline</label>
        <input id="dateInput" type="date">

        <label for="priorityInput">Priority</label>
        <select id="priorityInput">
          <option>Medium</option>
          <option>High</option>
          <option>Low</option>
        </select>

        <button class="add-btn" type="submit">+ Add Task</button>
      </form>
    </section>

    <section class="panel">
      <div class="list-heading">
        <h2>My Tasks</h2>
        <select id="filter">
          <option>All</option>
          <option>Pending</option>
          <option>Completed</option>
        </select>
      </div>
      <div id="taskList"></div>
    </section>

    <footer>Made with ❤️ by a student developer</footer>
  </div>

  <script src="script.js"></script>
</body>
</html>
